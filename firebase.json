{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.rules", ".firebaserc", "**/.*", "**/node_modules/**",
      "art/**", "design/**", "tools/**", "_backup_*/**", "exercises-dataset/**",
      "dev-*.html", "*.md"
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
